import { Button, ComboBox, LineEdit, StandardTableView, ScrollView, TextEdit } from "std-widgets.slint";
import { CoverPanel, CoverGeometry } from "cover-panel.slint";
import { NotesView, NoteFilterGeometry } from "notes-view.slint";
import { OrdersView, OrdersFilterGeometry } from "orders-view.slint";
import { ResultsView, ResultsFilterGeometry } from "results-view.slint";

component Field inherits VerticalLayout {
    in property <string> label;
    in property <string> value;
    spacing: 5px;
    Text { text: root.label; color: #5a6572; font-size: 12px; }
    Text { text: root.value; color: #162b40; font-size: 15px; wrap: word-wrap; }
}

export component AppWindow inherits Window {
    title: "CPRS Chart — Mock-only Rust prototype";
    preferred-width: 1180px;
    preferred-height: 800px;
    min-width: 980px;
    min-height: 680px;
    default-font-family: "Segoe UI";
    default-font-size: 14px;
    background: #eff2f5;
    forward-focus: search;

    in property <bool> selector-open: true;
    in property <bool> has-active: false;
    in property <string> active-name: "No patient selected";
    in property <string> active-detail: "Select an invented patient to open a mock chart.";
    in property <string> active-id;
    in property <string> active-location;
    in property <string> active-visit;
    in property <string> chart-summary;
    in property <string> fixture-date;
    in property <int> tab-index: 0;
    in property <string> placeholder;
    in-out property <string> query-text;
    in property <int> mode-index: 0;
    in property <int> simulation-index: 0;
    in property <[[StandardListViewItem]]> patient-rows;
    in-out property <int> selected-row: -1;
    in property <string> page-label;
    in property <bool> can-previous;
    in property <bool> can-next;
    in property <bool> search-loading;
    in property <bool> chart-loading;
    in property <bool> can-confirm;
    in property <bool> has-preview;
    in property <string> preview-name;
    in property <string> preview-id;
    in property <string> preview-dob;
    in property <string> preview-lookup;
    in property <string> preview-location;
    in property <string> preview-access;
    in property <string> preview-flag;
    in property <bool> show-acknowledgment;
    in property <string> acknowledgment;
    in property <string> message;
    in property <int> search-state: 0;
    in property <[[StandardListViewItem]]> problem-rows;
    in property <[[StandardListViewItem]]> allergy-rows;
    in property <[[StandardListViewItem]]> vital-rows;
    in property <[[StandardListViewItem]]> medication-rows;
    in property <[[StandardListViewItem]]> appointment-rows;
    in-out property <int> selected-problem: -1;
    in-out property <int> selected-allergy: -1;
    in-out property <int> selected-vital: -1;
    in-out property <int> selected-medication: -1;
    in-out property <int> selected-appointment: -1;
    in property <bool> detail-open;
    in property <bool> detail-loading;
    in property <bool> detail-error;
    in property <string> detail-title;
    in property <string> detail-body;
    in property <string> detail-identity;
    in property <[[StandardListViewItem]]> notes-rows;
    in-out property <int> selected-note: -1;
    in-out property <string> notes-query;
    in property <[string]> notes-authors;
    in property <int> notes-author-index;
    in-out property <string> notes-beginning;
    in-out property <string> notes-ending;
    in property <bool> notes-invalid-filter;
    in property <int> notes-scenario;
    in property <bool> notes-loading;
    in property <bool> notes-list-error;
    in property <string> notes-list-status;
    in property <string> note-identity;
    in property <string> note-body-status;
    in property <string> note-body;
    in property <bool> note-body-error;
    in property <bool> note-body-ready;
    callback notes-filter-edited(string);
    callback notes-author-changed(int);
    callback notes-dates-edited(string, string);
    callback reset-notes-filters();
    callback notes-scenario-changed(int);
    callback note-selected(int);
    callback retry-notes-list();
    callback retry-note();
    in property <[[StandardListViewItem]]> orders-rows;
    in-out property <int> selected-order: -1;
    in-out property <string> orders-query;
    in-out property <string> orders-beginning;
    in-out property <string> orders-ending;
    in property <bool> orders-invalid-filter;
    in property <int> orders-status-filter;
    in property <int> orders-scenario;
    in property <bool> orders-loading;
    in property <bool> orders-list-error;
    in property <string> orders-list-status;
    in property <string> order-identity;
    in property <string> order-body-status;
    in property <string> order-body;
    in property <bool> order-body-error;
    in property <bool> order-body-ready;
    in property <bool> order-detail-open;
    callback orders-filter-edited(string);
    callback orders-dates-edited(string, string);
    callback orders-reset-filters();
    callback orders-status-changed(int);
    callback orders-scenario-changed(int);
    callback order-selected(int);
    callback order-released(int);
    callback order-activated();
    callback close-order-detail();
    callback retry-orders-list();
    callback retry-order();

    in property <[[StandardListViewItem]]> results-rows;
    in-out property <int> selected-report: -1;
    in-out property <string> results-query;
    in-out property <string> results-beginning;
    in-out property <string> results-ending;
    in property <bool> results-invalid-filter;
    in property <int> results-scenario;
    in property <bool> results-loading;
    in property <bool> results-list-error;
    in property <string> results-list-status;
    in property <string> report-identity;
    in property <string> report-body-status;
    in property <string> report-body;
    in property <bool> report-body-error;
    in property <bool> report-body-ready;
    in property <bool> report-detail-open;
    callback results-filter-edited(string);
    callback results-dates-edited(string, string);
    callback results-reset-filters();
    callback results-scenario-changed(int);
    callback report-selected(int);
    callback report-released(int);
    callback report-activated();
    callback close-report-detail();
    callback retry-results-list();
    callback retry-report();

    callback open-selection();
    callback query-edited(string);
    callback mode-changed(int);
    callback simulation-changed(int);
    callback row-selected(int);
    callback row-released(int);
    callback confirm-selection();
    callback accept-acknowledgment();
    callback decline-acknowledgment();
    callback cancel-selection();
    callback previous-page();
    callback next-page();
    callback tab-changed(int);
    callback cover-selected(int, int);
    callback cover-released(int, int);
    callback cover-activated(int);
    callback close-detail();
    callback retry-detail();

    // Read-only test observation of actual widget focus; never displayed as product UI.
    out property <string> keyboard-focus: root.selector-open ? (search.has-focus ? "patient-search" : continue-button.has-focus ? "acknowledgment" : "patient-actions") : root.detail-open ? (detail-text.has-focus ? "cover-detail" : "cover-actions") : root.tab-index == 1 ? "notes-" + notes-view.keyboard-focus : root.tab-index == 2 ? "orders-" + orders-view.keyboard-focus : root.tab-index == 3 ? "results-" + results-view.keyboard-focus : "chart-actions";

    public function scroll-workspace-bottom() { workspace-scroll.content-y = min(0px, workspace-scroll.visible-height - workspace-scroll.content-height); }
    public function focus-search() { workspace-scroll.content-y = 0px; search.focus(); }
    public function focus-chart() { workspace-scroll.content-y = 0px; new-patient.focus(); }
    public function focus-acknowledgment() { root.scroll-workspace-bottom(); continue-button.focus(); }
    public function reveal-region(top: length, bottom: length) {
        // Absolute coordinates include the current scroll offset. Move only as
        // far as needed, then clamp; a tall region keeps its leading edge.
        if top < workspace-scroll.absolute-position.y || bottom - top > workspace-scroll.visible-height {
            workspace-scroll.content-y += workspace-scroll.absolute-position.y - top;
        } else if bottom > workspace-scroll.absolute-position.y + workspace-scroll.visible-height {
            workspace-scroll.content-y -= bottom - workspace-scroll.absolute-position.y - workspace-scroll.visible-height;
        }
        workspace-scroll.content-y = min(0px, max(workspace-scroll.content-y, workspace-scroll.visible-height - workspace-scroll.content-height));
    }
    public function reveal-cover(panel: int) {
        if panel == 0 { problem-panel.reveal-list(); } else if panel == 1 { allergy-panel.reveal-list(); } else if panel == 2 { vital-panel.reveal-list(); } else if panel == 3 { medication-panel.reveal-list(); } else { appointment-panel.reveal-list(); }
    }
    public function focus-cover(panel: int) { root.reveal-cover(panel); if panel == 0 { problem-panel.focus-list(); } else if panel == 1 { allergy-panel.focus-list(); } else if panel == 2 { vital-panel.focus-list(); } else if panel == 3 { medication-panel.focus-list(); } else { appointment-panel.focus-list(); } }
    // Layout probes for the opt-in timer journey; no native focus claim.
    out property <length> workspace-top: workspace-scroll.absolute-position.y;
    out property <length> workspace-visible-height: workspace-scroll.visible-height;
    out property <length> cover-content-height: workspace-scroll.content-height;
    out property <length> cover-scroll-y: workspace-scroll.content-y;
    out property <length> fixture-footer-top: fixture-footer.absolute-position.y;
    out property <length> fixture-footer-bottom: fixture-footer.absolute-position.y + fixture-footer.height;
    public function cover-geometry(panel: int) -> CoverGeometry {
        if panel == 0 { return problem-panel.geometry(); } else if panel == 1 { return allergy-panel.geometry(); } else if panel == 2 { return vital-panel.geometry(); } else if panel == 3 { return medication-panel.geometry(); }
        return appointment-panel.geometry();
    }
    // Probe setup only: place content without moving focus, clamped like reveal.
    public function set-cover-scroll(y: length) {
        workspace-scroll.content-y = min(0px, max(y, workspace-scroll.visible-height - workspace-scroll.content-height));
    }
    public function focus-cover-view(panel: int) {
        if panel == 0 { problem-panel.focus-view(); } else if panel == 1 { allergy-panel.focus-view(); } else if panel == 2 { vital-panel.focus-view(); } else if panel == 3 { medication-panel.focus-view(); } else { appointment-panel.focus-view(); }
    }
    public function focus-detail() { detail-text.focus(); }
    public function focus-notes-filter() { notes-view.focus-filter(); }
    public function focus-notes-body() { notes-view.focus-body(); }
    public function orders-geometry() -> OrdersFilterGeometry { return orders-view.geometry(); }
    public function results-geometry() -> ResultsFilterGeometry { return results-view.geometry(); }
    public function notes-geometry() -> NoteFilterGeometry { return notes-view.geometry(); }
    public function focus-orders-filter() { orders-view.focus-filter(); }
    public function focus-order-body() { orders-view.focus-body(); }

    public function focus-results-filter() { results-view.focus-filter(); }
    public function focus-report-body() { results-view.focus-body(); }

    shortcuts := FocusScope {
        focus-on-tab-navigation: false;
        focus-on-click: false;
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if event.text == Key.Escape && root.detail-open { root.close-detail(); return accept; }
            if event.text == Key.Escape && root.selector-open {
                if root.show-acknowledgment { root.decline-acknowledgment(); }
                else { root.cancel-selection(); }
                return accept;
            }
            if event.text == Key.Return && root.selector-open {
                if root.show-acknowledgment { root.accept-acknowledgment(); }
                else { root.confirm-selection(); }
                return accept;
            }
            reject
        }
        KeyBinding {
            keys: @keys(Control + F);
            activated => { if root.selector-open { root.focus-search(); } else if root.has-active && !root.detail-open { if root.tab-index == 1 { notes-view.focus-filter(); } else if root.tab-index == 2 { orders-view.focus-filter(); } else if root.tab-index == 3 { results-view.focus-filter(); } } }
        }
        KeyBinding {
            keys: @keys(Control + O);
            activated => { if !root.selector-open && !root.detail-open { root.open-selection(); } }
        }

        VerticalLayout {
            spacing: 0px;
            Rectangle {
                height: 44px;
                background: #193950;
                HorizontalLayout {
                    padding-left: 20px; padding-right: 20px;
                    Text { text: "CPRS Chart"; color: white; font-size: 21px; font-weight: 600; vertical-alignment: center; }
                    Text { text: "Rust desktop prototype"; color: #c5d9e6; horizontal-alignment: right; vertical-alignment: center; }
                }
            }
            Rectangle {
                height: 30px;
                background: #dcecf7;
                Text { x: 20px; width: parent.width - 40px; height: parent.height;
                    text: "MOCK ONLY  ·  All patient records are invented  ·  No live connection";
                    color: #193e58; font-size: 13px; vertical-alignment: center; }
            }
            Rectangle {
                height: 50px;
                background: #f7f8fa;
                HorizontalLayout {
                    padding: 9px; padding-left: 18px; padding-right: 18px; spacing: 16px;
                    new-patient := Button {
                        text: "Select new patient…"; enabled: !root.selector-open && !root.detail-open;
                        accessible-label: "Select new synthetic patient";
                        clicked => { root.open-selection(); }
                        changed has-focus => { if self.has-focus { workspace-scroll.content-y = 0px; } }
                    }
                    Text { text: root.selector-open ? "Ctrl+F Patient search" : root.tab-index == 0 ? "Ctrl+O Select patient" : "Ctrl+O Select patient   Ctrl+F Filter list"; color: #616e7a; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: "Read-only demonstration"; color: #516272; vertical-alignment: center; }
                }
            }
            Rectangle {
                height: 90px;
                background: white;
                border-width: 1px; border-color: #d5dce3;
                HorizontalLayout {
                    padding: 17px; spacing: 24px;
                    VerticalLayout {
                        spacing: 5px;
                        Text { text: root.active-name; color: #162e44; font-size: 22px; font-weight: 600; }
                        Text { text: root.active-detail; color: #536576; }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    VerticalLayout {
                        alignment: center; spacing: 5px;
                        Text { text: root.has-active ? "CURRENT CHART" : "CHART CLOSED"; color: #5d6d7a; font-size: 11px; horizontal-alignment: right; }
                        Text { text: root.has-active ? root.active-id : "Synthetic fixtures only"; color: #193950; font-size: 16px; horizontal-alignment: right; }
                    }
                }
            }

            workspace := Rectangle {
                vertical-stretch: 1;
                background: #eff2f5;
                workspace-scroll := ScrollView {
                    width: parent.width; height: parent.height;
                    content-width: self.visible-width;
                    // Cover Sheet's intrinsic minimum is independent of the
                    // viewport allocation. Selector/browser sizing stays separate.
                    content-height: max(self.visible-height, root.show-acknowledgment ? 560px : !root.selector-open && root.has-active && root.tab-index == 0 ? cover-layout.min-height + 48px : !root.selector-open && (root.tab-index >= 1) ? 600px : 440px);
                    changed visible-height => { self.content-y = min(0px, max(self.content-y, self.visible-height - self.content-height)); }
                    changed content-height => { self.content-y = min(0px, max(self.content-y, self.visible-height - self.content-height)); }
                    Rectangle {
                    width: workspace-scroll.visible-width; height: workspace-scroll.content-height;
                selector := Rectangle {
                    visible: root.selector-open;
                    width: parent.width; height: parent.height;
                    background: #eff2f5;
                    VerticalLayout {
                        padding: 18px; spacing: 12px;
                        HorizontalLayout {
                            Text { text: "Patient selection"; font-size: 21px; font-weight: 600; color: #1a354c; }
                            Text { text: root.has-active ? "Current chart stays open until confirmation" : "Choose a fixture to get started";
                                horizontal-alignment: right; color: #5f6c79; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            spacing: 12px;
                            search := LineEdit {
                                text <=> root.query-text;
                                placeholder-text: "Name, SYNTH-001, or demo lookup x1001";
                                accessible-label: "Search invented patients";
                                enabled: !root.chart-loading && !root.show-acknowledgment;
                                edited(text) => { root.query-edited(text); }
                                accepted => { patient-table.focus(); }
                            }
                            ComboBox {
                                preferred-width: 180px;
                                model: ["All fixtures", "Demo roster"];
                                current-index: root.mode-index;
                                accessible-label: "Synthetic patient list";
                                enabled: !root.chart-loading && !root.show-acknowledgment;
                                selected(value) => { root.mode-changed(self.current-index); }
                            }
                            ComboBox {
                                preferred-width: 205px;
                                model: ["Normal simulation", "Search unavailable", "Malformed result", "Chart unavailable", "Slow search", "Detail unavailable", "Notes list unavailable", "Note text unavailable", "Slow note replies", "Orders list unavailable", "Order detail unavailable", "Slow order replies", "Results list unavailable", "Report text unavailable", "Slow report replies", "Invalid search page"];
                                current-index: root.simulation-index;
                                accessible-label: "Mock simulation scenario";
                                enabled: !root.chart-loading && !root.show-acknowledgment;
                                selected(value) => { root.simulation-changed(self.current-index); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 8px;
                                Rectangle {
                                    vertical-stretch: 1; min-height: 210px;
                                    background: white; border-width: 1px; border-color: #ccd6df;
                                    patient-table := StandardTableView {
                                        width: parent.width; height: parent.height;
                                        rows: root.patient-rows;
                                        current-row <=> root.selected-row;
                                        columns: [
                                            { title: "Patient", width: 210px, min-width: 150px },
                                            { title: "Synthetic ID", width: 126px, min-width: 110px },
                                            { title: "Fixture DOB", width: 120px, min-width: 100px },
                                            { title: "Demo lookup", width: 136px, min-width: 120px }
                                        ];
                                        accessible-label: "Invented patient search results. " + (root.has-preview ? "Selected " + root.preview-name + ", " + root.preview-id : "No patient selected");
                                        enabled: !root.search-loading && !root.chart-loading && !root.show-acknowledgment;
                                        current-row-changed(index) => { root.row-selected(index); }
                                        // Keep fixture order; headers must not imply an unapplied local sort.
                                        sort-ascending(column) => { self.columns[column].sort-order = SortOrder.unsorted; }
                                        sort-descending(column) => { self.columns[column].sort-order = SortOrder.unsorted; }
                                        row-pointer-event(index, event, position) => {
                                            if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                                                root.row-released(index);
                                            }
                                        }
                                    }
                                    if root.search-state == 1 || root.search-state == 3 || root.search-state == 4 || root.search-state == 5: Rectangle {
                                        x: 1px; y: 43px; width: parent.width - 2px; height: parent.height - 44px;
                                        background: white;
                                        VerticalLayout {
                                            padding: 24px; alignment: center; spacing: 12px;
                                            Text {
                                                text: root.search-state == 1 ? "Searching synthetic records…" : root.search-state == 3 ? "No matching fixtures" : root.search-state == 5 ? "Malformed mock result" : "Mock search unavailable";
                                                font-size: 18px; font-weight: 600; color: root.search-state >= 4 ? #9d2934 : #4f6578;
                                                horizontal-alignment: center; wrap: word-wrap;
                                            }
                                            Text { text: root.search-state == 1 ? "You can keep typing; older responses are discarded." : root.message;
                                                color: #5b6c7a; horizontal-alignment: center; wrap: word-wrap; }
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text { text: root.page-label; color: #5c6a77; vertical-alignment: center; }
                                    Rectangle { horizontal-stretch: 1; background: transparent; }
                                    Button { text: "Previous"; enabled: root.can-previous && !root.chart-loading && !root.show-acknowledgment; clicked => { root.previous-page(); } }
                                    Button { text: "Next"; enabled: root.can-next && !root.chart-loading && !root.show-acknowledgment; clicked => { root.next-page(); } }
                                }
                            }
                            Rectangle {
                                preferred-width: 300px; min-width: 270px;
                                horizontal-stretch: 0;
                                background: white; border-width: 1px; border-color: #ccd6df;
                                ScrollView {
                                    width: parent.width; height: parent.height;
                                    VerticalLayout {
                                        padding: 18px; spacing: 16px;
                                        Text { text: "Patient demographics"; color: #1b3b52; font-size: 17px; font-weight: 600; }
                                        Text { text: root.has-preview ? root.preview-name : "Select a patient row"; color: #223a50; font-weight: 600; wrap: word-wrap; }
                                        Field { label: "Synthetic identifier"; value: root.has-preview ? root.preview-id : "—"; }
                                        Field { label: "Fixture date of birth"; value: root.has-preview ? root.preview-dob : "—"; }
                                        Field { label: "Training location"; value: root.has-preview ? root.preview-location : "—"; }
                                        Field { label: "Demo lookup code · not an SSN"; value: root.has-preview ? root.preview-lookup : "—"; }
                                        Text { text: root.has-preview ? root.preview-access : "Previewing a row does not change the current chart."; color: #66501c; wrap: word-wrap; }
                                        if root.preview-flag != "": Text { text: root.preview-flag; color: #8f343a; wrap: word-wrap; }
                                    }
                                }
                            }
                        }
                        acknowledgment-panel := Rectangle {
                            visible: root.show-acknowledgment;
                            height: root.show-acknowledgment ? ack-layout.min-height : 0px;
                            background: #fff4dc; border-width: 1px; border-color: #d9be7b;
                            ack-layout := HorizontalLayout {
                                padding: 14px; spacing: 14px;
                                VerticalLayout {
                                    Text { text: "Mock acknowledgment"; font-weight: 600; color: #634b12; }
                                    Text { text: root.acknowledgment; color: #634b12; wrap: word-wrap; }
                                }
                                continue-button := Button { text: "Continue to mock chart"; clicked => { root.accept-acknowledgment(); } }
                                Button { text: "Back"; clicked => { root.decline-acknowledgment(); } }
                            }
                        }
                        HorizontalLayout {
                            spacing: 10px;
                            Text { text: root.chart-loading ? "Loading selected mock chart…" : "Review the synthetic ID before opening a chart."; color: #5c6b79; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; background: transparent; }
                            Button { text: root.chart-loading ? "Loading…" : "OK — Open mock chart"; primary: true;
                                enabled: root.can-confirm && !root.show-acknowledgment;
                                changed has-focus => { if self.has-focus { root.scroll-workspace-bottom(); } }
                                clicked => { root.confirm-selection(); } }
                            Button { text: "Cancel"; changed has-focus => { if self.has-focus { root.scroll-workspace-bottom(); } } clicked => { root.cancel-selection(); } }
                        }
                    }
                }

                chart := Rectangle {
                    visible: !root.selector-open && !root.detail-open;
                    width: parent.width; height: parent.height;
                    background: #eff2f5;
                    VerticalLayout {
                        padding: 24px; spacing: 0px;
                        if !root.has-active: VerticalLayout {
                            alignment: center; spacing: 16px;
                            Text { text: "No mock chart is open"; color: #304f65; font-size: 24px; horizontal-alignment: center; }
                            Text { text: "Select an invented patient to explore the read-only shell."; color: #617180; horizontal-alignment: center; }
                            HorizontalLayout { alignment: center; Button { text: "Select a mock patient"; clicked => { root.open-selection(); } } }
                        }
                        Rectangle {
                            visible: root.has-active && root.tab-index == 0;
                            min-height: 0px;
                            max-height: root.has-active && root.tab-index == 0 ? 10000px : 0px;
                            vertical-stretch: root.has-active && root.tab-index == 0 ? 1 : 0;
                            background: transparent;
                            cover-layout := VerticalLayout {
                            spacing: 18px;
                            Text { text: "Cover Sheet"; color: #1e3b52; font-size: 23px; font-weight: 600; }
                            HorizontalLayout {
                                spacing: 16px;
                                problem-panel := CoverPanel {
                                    title: "Problem List"; patient-id: root.active-id; rows: root.problem-rows;
                                    enabled: !root.detail-open;
                                    selected-row <=> root.selected-problem;
                                    selected(index) => { root.cover-selected(0, index); }
                                    released(index) => { root.cover-released(0, index); }
                                    activated => { root.cover-activated(0); }
                                    footer-focused => { problem-panel.reveal-footer(); }
                                    reveal-request(top, bottom) => { root.reveal-region(top, bottom); }
                                    list-focused-event => { root.reveal-cover(0); }
                                }
                                allergy-panel := CoverPanel {
                                    title: "Allergies"; patient-id: root.active-id; allergies: true; rows: root.allergy-rows;
                                    enabled: !root.detail-open;
                                    selected-row <=> root.selected-allergy;
                                    selected(index) => { root.cover-selected(1, index); }
                                    released(index) => { root.cover-released(1, index); }
                                    activated => { root.cover-activated(1); }
                                    footer-focused => { allergy-panel.reveal-footer(); }
                                    reveal-request(top, bottom) => { root.reveal-region(top, bottom); }
                                    list-focused-event => { root.reveal-cover(1); }
                                }
                            }
                            vital-panel := CoverPanel {
                                title: "Vitals"; patient-id: root.active-id; vitals: true; rows: root.vital-rows;
                                enabled: !root.detail-open;
                                selected-row <=> root.selected-vital;
                                selected(index) => { root.cover-selected(2, index); }
                                released(index) => { root.cover-released(2, index); }
                                activated => { root.cover-activated(2); }
                                footer-focused => { vital-panel.reveal-footer(); }
                                reveal-request(top, bottom) => { root.reveal-region(top, bottom); }
                                list-focused-event => { root.reveal-cover(2); }
                            }
                            medication-panel := CoverPanel {
                                title: "Active Medications"; patient-id: root.active-id; medications: true; rows: root.medication-rows;
                                enabled: !root.detail-open;
                                selected-row <=> root.selected-medication;
                                selected(index) => { root.cover-selected(3, index); }
                                released(index) => { root.cover-released(3, index); }
                                activated => { root.cover-activated(3); }
                                footer-focused => { medication-panel.reveal-footer(); }
                                reveal-request(top, bottom) => { root.reveal-region(top, bottom); }
                                list-focused-event => { root.reveal-cover(3); }
                            }
                            appointment-panel := CoverPanel {
                                title: "Appointments"; patient-id: root.active-id; appointments: true; rows: root.appointment-rows;
                                enabled: !root.detail-open;
                                selected-row <=> root.selected-appointment;
                                selected(index) => { root.cover-selected(4, index); }
                                released(index) => { root.cover-released(4, index); }
                                activated => { root.cover-activated(4); }
                                footer-focused => { appointment-panel.reveal-footer(); }
                                reveal-request(top, bottom) => { root.reveal-region(top, bottom); }
                                list-focused-event => { root.reveal-cover(4); }
                            }
                            fixture-footer := Text { text: "Five synthetic panels · All entries are invented display text · Fixture date: " + root.fixture-date;
                                color: #617180; font-size: 12px; wrap: word-wrap; }
                            }
                        }
                        notes-view := NotesView {
                            visible: root.has-active && root.tab-index == 1;
                            min-height: root.has-active && root.tab-index == 1 ? self.required-height : 0px; max-height: root.has-active && root.tab-index == 1 ? 10000px : 0px;
                            rows: root.notes-rows; selected-row <=> root.selected-note; query <=> root.notes-query;
                            authors: root.notes-authors; author-index: root.notes-author-index;
                            beginning <=> root.notes-beginning; ending <=> root.notes-ending;
                            patient-id: root.active-id; invalid-filter: root.notes-invalid-filter;
                            scenario: root.notes-scenario; loading: root.notes-loading;
                            list-error: root.notes-list-error; list-status: root.notes-list-status;
                            identity: root.note-identity; body: root.note-body; body-status: root.note-body-status;
                            body-error: root.note-body-error; body-ready: root.note-body-ready;
                            filter-edited(query) => { root.notes-filter-edited(query); }
                            author-changed(index) => { root.notes-author-changed(index); }
                            dates-edited(beginning, ending) => { root.notes-dates-edited(beginning, ending); }
                            reset-filters => { root.reset-notes-filters(); }
                            scenario-changed(index) => { root.notes-scenario-changed(index); }
                            selected(index) => { root.note-selected(index); }
                            retry-list => { root.retry-notes-list(); }
                            retry-body => { root.retry-note(); }
                            top-focused => { workspace-scroll.content-y = 0px; }
                            body-focused => { root.scroll-workspace-bottom(); }
                        }
                        orders-view := OrdersView {
                            visible: root.has-active && root.tab-index == 2;
                            min-height: root.has-active && root.tab-index == 2 ? self.required-height : 0px; max-height: root.has-active && root.tab-index == 2 ? 10000px : 0px;
                            rows: root.orders-rows; selected-row <=> root.selected-order; query <=> root.orders-query;
                            beginning <=> root.orders-beginning; ending <=> root.orders-ending;
                            patient-id: root.active-id; invalid-filter: root.orders-invalid-filter;
                            status-filter: root.orders-status-filter; scenario: root.orders-scenario; loading: root.orders-loading;
                            list-error: root.orders-list-error; list-status: root.orders-list-status;
                            identity: root.order-identity; body: root.order-body; body-status: root.order-body-status;
                            body-error: root.order-body-error; body-ready: root.order-body-ready; detail-open: root.order-detail-open;
                            filter-edited(query) => { root.orders-filter-edited(query); }
                            dates-edited(beginning, ending) => { root.orders-dates-edited(beginning, ending); }
                            reset-filters => { root.orders-reset-filters(); }
                            status-changed(index) => { root.orders-status-changed(index); }
                            scenario-changed(index) => { root.orders-scenario-changed(index); }
                            selected(index) => { root.order-selected(index); }
                            released(index) => { root.order-released(index); }
                            activated => { root.order-activated(); }
                            closed => { root.close-order-detail(); }
                            retry-list => { root.retry-orders-list(); }
                            retry-body => { root.retry-order(); }
                            top-focused => { workspace-scroll.content-y = 0px; }
                            body-focused => { root.scroll-workspace-bottom(); }
                        }
                        results-view := ResultsView {
                            visible: root.has-active && root.tab-index == 3;
                            min-height: root.has-active && root.tab-index == 3 ? self.required-height : 0px; max-height: root.has-active && root.tab-index == 3 ? 10000px : 0px;
                            rows: root.results-rows; selected-row <=> root.selected-report; query <=> root.results-query;
                            beginning <=> root.results-beginning; ending <=> root.results-ending;
                            patient-id: root.active-id; invalid-filter: root.results-invalid-filter;
                            scenario: root.results-scenario; loading: root.results-loading;
                            list-error: root.results-list-error; list-status: root.results-list-status;
                            identity: root.report-identity; body: root.report-body; body-status: root.report-body-status;
                            body-error: root.report-body-error; body-ready: root.report-body-ready; detail-open: root.report-detail-open;
                            filter-edited(query) => { root.results-filter-edited(query); }
                            dates-edited(beginning, ending) => { root.results-dates-edited(beginning, ending); }
                            reset-filters => { root.results-reset-filters(); }
                            scenario-changed(index) => { root.results-scenario-changed(index); }
                            selected(index) => { root.report-selected(index); }
                            released(index) => { root.report-released(index); }
                            activated => { root.report-activated(); }
                            closed => { root.close-report-detail(); }
                            retry-list => { root.retry-results-list(); }
                            retry-body => { root.retry-report(); }
                            top-focused => { workspace-scroll.content-y = 0px; }
                            body-focused => { root.scroll-workspace-bottom(); }
                        }

                    }
                }
            }
            }
            }
            Rectangle {
                height: 44px;
                background: #e1e7ed;
                HorizontalLayout {
                    padding: 6px; padding-left: 18px; spacing: 6px;
                    for label[index] in ["Cover Sheet", "Notes", "Orders", "Results"]: Button {
                        text: label; checked: root.tab-index == index;
                        enabled: root.has-active && !root.selector-open && !root.detail-open;
                        clicked => { root.tab-changed(index); }
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text { text: "Prototype navigation"; color: #637482; vertical-alignment: center; }
                }
            }
            Rectangle {
                height: 48px; background: #f9fafb;
                Text { x: 18px; width: parent.width - 36px; height: parent.height;
                    text: root.message; color: #3b5265; vertical-alignment: center; wrap: word-wrap; font-size: 13px; }
            }
        }
        detail-overlay := Rectangle {
            visible: root.detail-open;
            x: 0px; y: 214px; width: parent.width; height: parent.height - 214px;
            background: #e2e9ef;
            accessible-role: groupbox;
            accessible-label: root.detail-title;
            VerticalLayout {
                padding: 26px; spacing: 12px;
                Text { text: root.detail-title; font-size: 21px; font-weight: 600; color: #23445b; wrap: word-wrap; }
                Text { text: root.detail-identity; color: #526879; wrap: word-wrap; }
                Text { text: "MOCK ONLY · Invented item details · Read-only"; color: #66501c; }
                detail-text := TextEdit {
                    text: root.detail-body;
                    read-only: true; font-family: "Lucida Console"; font-size: 13px; wrap: no-wrap;
                    accessible-label: (root.detail-loading ? "Loading synthetic details. " : root.detail-error ? "Synthetic detail error. " : "Read-only synthetic item details. ") + root.detail-identity;
                }
                HorizontalLayout {
                    spacing: 12px;
                    if root.detail-error: Button { text: "Retry mock detail"; clicked => { root.retry-detail(); } }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    detail-close := Button { text: "Close"; accessible-label: "Close synthetic item detail"; clicked => { root.close-detail(); } }
                }
            }
        }
    }
}
