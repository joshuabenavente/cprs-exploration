import { StandardTableView, Button } from "std-widgets.slint";
export struct CoverGeometry {
    top: length, bottom: length, table-top: length, table-bottom: length,
    view-top: length, help-bottom: length,
}
export component CoverPanel inherits Rectangle {
    in property <string> title;
    in property <string> patient-id;
    in property <bool> allergies;
    in property <bool> vitals;
    in property <bool> medications;
    in property <bool> appointments;
    in property <bool> enabled: true;
    in property <[[StandardListViewItem]]> rows;
    in-out property <int> selected-row: -1;
    callback selected(int);
    callback released(int);
    callback activated();
    callback footer-focused();
    callback list-focused-event();
    callback reveal-request(length, length);
    public function reveal-list() { root.reveal-request(root.absolute-position.y, data.absolute-position.y + data.height); }
    public function reveal-footer() { root.reveal-request(view.absolute-position.y, help.absolute-position.y + help.height); }
    public function focus-list() { root.list-focused-event(); data.focus(); }
    public function focus-view() { view.focus(); root.reveal-footer(); }
    public function geometry() -> CoverGeometry {
        return { top: root.absolute-position.y, bottom: root.absolute-position.y + root.height,
            table-top: data.absolute-position.y, table-bottom: data.absolute-position.y + data.height,
            view-top: view.absolute-position.y, help-bottom: help.absolute-position.y + help.height };
    }
    background: white; border-width: 1px; border-color: #c9d5df;
    accessible-role: groupbox;
    accessible-label: root.title + " for synthetic patient " + root.patient-id + (root.rows.length == 0 ? ". No synthetic entries in this panel. This is not a clinical finding." : "");
    // Intrinsic layout requirements include heading, table, View, help and gaps.
    min-width: 390px; min-height: max(220px, panel-layout.min-height);
    focus := FocusScope {
        focus-on-tab-navigation: false;
        focus-on-click: false;
        width: parent.width; height: parent.height;
        forward-focus: data;
        // Fluent forwards focus to a private scope, so data.has-focus cannot
        // observe Tab entry. Key release reaches the newly focused descendant.
        capture-key-released(event) => {
            if event.text == Key.Tab && !view.has-focus { root.list-focused-event(); }
            reject
        }
        key-pressed(event) => {
            if root.enabled && (event.text == Key.Return || event.text == " ") {
                root.activated(); return accept;
            }
            reject
        }
        panel-layout := VerticalLayout {
            padding: 12px; spacing: 10px;
            Text { text: root.title; color: #23445b; font-size: 18px; font-weight: 600; }
            Rectangle {
                vertical-stretch: 1;
                VerticalLayout {
                padding: 0px;
                data := StandardTableView {
                    min-height: 140px;
                    enabled: root.enabled && root.rows.length > 0;
                    accessible-label: root.title + " synthetic items for " + root.patient-id + (root.selected-row >= 0 ? ". Selected " + root.rows[root.selected-row][0].text : ". No item selected");
                    rows: root.rows; current-row <=> root.selected-row;
                    columns: root.appointments ? [
                        { title: "Date/Time", width: 225px, min-width: 215px },
                        { title: "Location", width: 620px, min-width: 560px },
                        { title: "Action Req", width: 180px, min-width: 160px }
                    ] : root.medications ? [
                        { title: "Medication", width: 800px, min-width: 740px },
                        { title: "Status", width: 180px, min-width: 160px }
                    ] : root.vitals ? [
                        { title: "Vital", width: 165px, min-width: 135px },
                        { title: "Value", width: 160px, min-width: 140px },
                        { title: "Date Taken", width: 205px, min-width: 195px },
                        { title: "Quals", width: 320px, min-width: 230px }
                    ] : root.allergies ? [
                        { title: "Agent", width: 190px, min-width: 140px },
                        { title: "Severity", width: 100px, min-width: 90px },
                        { title: "Signs/Symptoms", width: 155px, min-width: 145px }
                    ] : [{ title: "Problem List", width: 440px, min-width: 320px }];
                    current-row-changed(index) => { root.list-focused-event(); root.selected(index); }
                    sort-ascending(column) => { self.columns[column].sort-order = SortOrder.unsorted; }
                    sort-descending(column) => { self.columns[column].sort-order = SortOrder.unsorted; }
                    row-pointer-event(index, event, position) => {
                        if event.kind == PointerEventKind.up && event.button == PointerEventButton.left { root.released(index); }
                    }
                }
                }
                if root.rows.length == 0: Text {
                    x: 12px; y: 55px; width: parent.width - 24px;
                    text: "No synthetic entries in this panel. This is not a clinical finding.";
                    color: #617180; wrap: word-wrap;
                }
            }
            view := Button {
                text: "View item detail"; accessible-label: "View selected " + root.title + " item detail";
                enabled: root.enabled && root.selected-row >= 0;
                clicked => { root.activated(); }
                changed has-focus => { if self.has-focus { root.footer-focused(); } }
            }
            help := Text { text: "Enter or Space opens the selected item."; color: #617180; font-size: 12px; wrap: word-wrap; }
        }
    }
}
